# PostgreSQL connection string
DATABASE_URL="postgresql://board:board@localhost:5432/board_portal?schema=public"

# Sign-in (NextAuth). The public URL of the site, and a long random secret:
#   openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Microsoft Entra ID (Azure AD) app registration for staff sign-in.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Local development only: sign in as any staff email without a password.
# Ignored when NODE_ENV=production.
DEV_LOGIN="false"
